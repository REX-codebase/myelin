$ model
<!-- TitleInput.vue -->
<script setup lang="ts">
const title = defineModel<string>('title', { required: true })
const published = defineModel<boolean>('published', { default: false })
</script>

<template>
  <input v-model="title" placeholder="Title" />
  <label><input v-model="published" type="checkbox" /> Published</label>
</template>

<!-- Parent usage: <TitleInput v-model:title="post.title" v-model:published="post.published" /> -->
