---
import Layout from '../layouts/Layout.astro';

const posts = await Astro.glob('../content/blog/*.md');
const sorted = posts.sort((a, b) => b.frontmatter.pubDate - a.frontmatter.pubDate);
---

<Layout title="Blog">
	<ul>
		{sorted.map((post) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}
	</ul>
</Layout>
