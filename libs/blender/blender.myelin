bpy.ops.wm.obj_export(filepath="/tmp/scene.obj", export_selected_objects=True)
bpy.ops.wm.ply_export(filepath="/tmp/scene.ply")
bpy.ops.wm.stl_export(filepath="/tmp/scene.stl")
bpy.ops.wm.obj_import(filepath="/tmp/incoming.obj")
bpy.ops.export_scene.gltf(filepath="/tmp/scene.glb")
