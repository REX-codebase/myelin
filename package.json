{
  "name": "myelin-ledger",
  "version": "0.2.1",
  "description": "Myelin: a model-agnostic, machine-checkable rule ledger format for LLM-generated code.",
  "type": "module",
  "author": "REX-codebase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REX-codebase/myelin.git"
  },
  "homepage": "https://github.com/REX-codebase/myelin#readme",
  "bugs": {
    "url": "https://github.com/REX-codebase/myelin/issues"
  },
  "bin": {
    "myelin": "bin/myelin.mjs",
    "myelin-ledger": "bin/myelin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "libs",
    "integrations",
    "eval",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "self": "node bin/myelin.mjs self examples libs",
    "bench": "node bin/myelin.mjs bench && node bin/myelin.mjs bench --cross",
    "bench:wild": "sh eval/wild/fetch.sh && node eval/wild/run.mjs",
    "assets": "node scripts/make-assets.mjs",
    "check": "npm test && npm run self && npm run bench"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "prompt",
    "rules",
    "guardrails",
    "linter",
    "agents",
    "skills",
    "threejs",
    "react",
    "nextjs",
    "tailwind",
    "migration",
    "ai-coding"
  ],
  "license": "MIT"
}
